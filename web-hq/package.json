{
  "name": "class-site-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node --env-file-if-exists=.env --experimental-sqlite scripts/start.mjs",
    "dev": "npm start",
    "demo": "node --env-file-if-exists=.env --experimental-sqlite scripts/start.mjs --demo",
    "test": "node --experimental-sqlite --test tests/*.test.mjs",
    "db:generate": "drizzle-kit generate",
    "migration:summary": "node --env-file-if-exists=.env --experimental-sqlite scripts/migrate-to-supabase.mjs",
    "migration:check": "node --env-file-if-exists=.env --experimental-sqlite scripts/migrate-to-supabase.mjs --check",
    "migration:apply": "node --env-file-if-exists=.env --experimental-sqlite scripts/migrate-to-supabase.mjs --apply",
    "prepare:github": "node --env-file-if-exists=.env scripts/prepare-github.mjs"
  },
  "dependencies": {
    "@babel/standalone": "7.26.9",
    "@codemirror/commands": "6.8.1",
    "@codemirror/lang-javascript": "6.2.3",
    "@codemirror/language": "6.11.0",
    "@codemirror/search": "6.5.8",
    "@codemirror/state": "6.5.2",
    "@codemirror/view": "6.36.5",
    "@tailwindcss/browser": "4.1.17",
    "codemirror": "6.0.1",
    "diff": "^9.0.0",
    "lucide-react": "0.468.0",
    "postgres": "4.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "10.1.0",
    "three": "0.186.0"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.7",
    "drizzle-orm": "0.45.4",
    "esbuild": "0.25.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.0"
    },
    "@codemirror/search": {
      "@codemirror/state": "$@codemirror/state",
      "@codemirror/view": "$@codemirror/view"
    }
  }
}
